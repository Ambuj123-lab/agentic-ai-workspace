# ==============================================================================
# Agentic AI Workspace — Frontend Environment Template
# ==============================================================================
# Security Notice: This file documents runtime environment variables required
# by NextAuth and API proxying. Never commit real secrets.
# ==============================================================================

# --- NextAuth.js Configuration ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_32_char_hex_key

# --- Google OAuth 2.0 Credentials ---
# Obtained from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# --- Backend API Connection ---
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
