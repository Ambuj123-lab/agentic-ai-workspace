# ==============================================================================
# Agentic AI Workspace — Runtime Environment Template
# ==============================================================================
# Security Notice: This file documents all environment variables required or
# supported by the system. NEVER commit real secret values to version control.
# ==============================================================================

# --- Primary LLM Provider Configuration ---
# Options: "gemini" or "openrouter"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7

# --- LLM API Credentials ---
# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# OpenRouter API Key (Required if LLM_PROVIDER=openrouter or as fallback)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# --- Database (MongoDB Atlas for Thread-Isolated Session Persistence) ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=Agentic_MCP_Chatbot_DB

# --- Autonomous Tool Execution Credentials ---
# Tavily API Key for real-time web search and grounded factual queries
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# RapidAPI Key for Yahoo Finance market data and real-time ticker prices
RAPIDAPI_KEY=your_rapidapi_key_here

# GitHub Personal Access Token (Read-only PAT, increases rate limit to 5000 req/hr)
GITHUB_TOKEN=github_pat_your_token_here

# --- Gmail SMTP / IMAP Operations (Human-in-the-Loop Email Tool) ---
# Your Gmail account address used for sending approved emails and reading threads
GMAIL_SENDER_EMAIL=your_email@gmail.com

# 16-character Google App Password (generated via Google Account > Security > App Passwords)
GMAIL_APP_PASSWORD=your_16_character_app_password

# Optional: Local filesystem path to resume PDF for automated professional attachments
RESUME_PDF_PATH=path/to/your/resume.pdf

# --- Observability & Telemetry (Langfuse / LangSmith) ---
LANGFUSE_SECRET_KEY=sk-lf-your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=pk-lf-your_langfuse_public_key_here
LANGFUSE_HOST=https://us.cloud.langfuse.com

# LangSmith Tracing (Optional fallback)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=Agentic-AI-Workspace

# --- MCP Tool Discovery (SSE Transport Client) ---
# JSON array of external MCP server configurations:
# Example: [{"name": "filesystem", "url": "http://localhost:8001/sse"}]
MCP_SERVERS_CONFIG=[]

# --- Web Frontend & CORS ---
FRONTEND_URL=http://localhost:3000
